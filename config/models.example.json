{
  "$schema_version": "bakacoding.model-config.v1",
  "providers": {
    "deepseek": {
      "base_url": "https://api.deepseek.com/anthropic",
      "protocol": "anthropic-messages",
      "credential_ref": "env:DEEPSEEK_API_KEY",
      "models": {
        "deepseek-flash": {
          "expected_display_name": "DeepSeek-V4.1-Flash",
          "thinking_enabled": true
        }
      }
    }
  },
  "roles": {
    "supervisor": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "effort": "max"
    },
    "review_board": {
      "members": [
        {
          "id": "reviewer-1",
          "provider": "deepseek",
          "model": "deepseek-flash",
          "effort": "high"
        },
        {
          "id": "reviewer-2",
          "provider": "deepseek",
          "model": "deepseek-flash",
          "effort": "high"
        }
      ],
      "review_assignment": "least_busy",
      "sticky_on_resubmit": true,
      "skip_rate_limited": true
    },
    "sub_agent": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "effort": "high"
    },
    "coder": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "effort": "low",
      "resubmit_effort": ["low", "high", "high"]
    }
  },
  "routing": {
    "automatic_model_switching": false,
    "fallbacks": []
  },
  "validation": {
    "unsupported_effort": "error",
    "display_name_change": "require_confirmation"
  },
  "budget": {
    "daily_micro_usd": 5000000,
    "per_ticket_ratio": 0.05,
    "offpeak_preference": false
  },
  "pipeline": {
    "concurrency_max": 8,
    "concurrency_hard_max": 64,
    "resubmit_limits": {
      "review": 3,
      "conflict": 2
    },
    "resplit_limit": 2,
    "supervisor_backlog_limit": 10,
    "main_merge": "user",
    "max_turns": 40
  },
  "backpressure": {
    "reviews_per_member": 2,
    "halve_at": 2,
    "pause_at": 4,
    "recover_step": 1,
    "recover_interval_min": 5
  },
  "diagnostics": {
    "retention_days": 30
  }
}
