{
  "$schema_version": "bakacoding.model-config.v1",
  "providers": {
    "deepseek": {
      "base_url": "https://api.deepseek.com/anthropic",
      "protocol": "anthropic-messages",
      "credential_ref": "env:DEEPSEEK_API_KEY",
      "models": {
        "deepseek-flash": {
          "expected_display_name": "DeepSeek-V4.1-Flash",
          "thinking_enabled": true,
          "effort_map": {
            "target_field": "output_config.effort",
            "values": {
              "off": "off",
              "low": "low",
              "high": "high",
              "max": "max"
            }
          }
        }
      }
    }
  },
  "roles": {
    "supervisor": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "effort": "max"
    },
    "review_board": {
      "members": [
        {
          "id": "reviewer-1",
          "provider": "deepseek",
          "model": "deepseek-flash",
          "effort": "high"
        },
        {
          "id": "reviewer-2",
          "provider": "deepseek",
          "model": "deepseek-flash",
          "effort": "high"
        }
      ]
    },
    "sub_agent": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "effort": "high"
    },
    "coder": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "effort": "low"
    }
  },
  "routing": {
    "automatic_model_switching": false,
    "fallbacks": []
  },
  "validation": {
    "unsupported_effort": "error",
    "display_name_change": "require_confirmation"
  }
}
