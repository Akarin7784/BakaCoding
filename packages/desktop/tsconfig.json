{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../config-budget"
    },
    {
      "path": "../storage"
    },
    {
      "path": "../types"
    },
    {
      "path": "../app"
    },
    {
      "path": "../supervisor"
    },
    {
      "path": "../diagnostics"
    },
    {
      "path": "../pr"
    }
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
